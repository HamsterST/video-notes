{
  "manifest_version": 3,
  "name": "VideoNotes",
  "version": "0.3.1",
  "description": "将当前视频的字幕提取到本机，支持音频转写后备流程。",
  "permissions": [
    "activeTab",
    "cookies",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://*.douyin.com/*"
  ],
  "action": {
    "default_title": "用 VideoNotes 提取内容"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "120",
  "key": ""
}
